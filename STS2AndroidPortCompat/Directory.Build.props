<Project>
  <PropertyGroup>
    <ReferenceFlavor Condition="'$(ReferenceFlavor)' == ''">runtime</ReferenceFlavor>

    <!--
      Reference DLLs are intentionally supplied by local configuration rather than
      hard-coded workspace paths. Parent build scripts pass CompatReferenceDir from
      .env/local.properties. For standalone builds, set one of these environment
      variables before running dotnet build:

        STS2_RUNTIME_REFERENCE_DIR
        STS2_ORIGINAL_V103_REFERENCE_DIR
        STS2_ORIGINAL_V1061_REFERENCE_DIR

      The refs/* directories are optional local symlink/copy locations and are not
      required by repository scripts.
    -->
    <RuntimeReferenceDir>$(STS2_RUNTIME_REFERENCE_DIR)</RuntimeReferenceDir>
    <OriginalReferenceDir>$(STS2_ORIGINAL_V103_REFERENCE_DIR)</OriginalReferenceDir>
    <Original1061ReferenceDir>$(STS2_ORIGINAL_V1061_REFERENCE_DIR)</Original1061ReferenceDir>
    <OriginalReferenceDir Condition="'$(OriginalReferenceDir)' == ''">../refs/original</OriginalReferenceDir>
    <Original1061ReferenceDir Condition="'$(Original1061ReferenceDir)' == ''">../refs/original-v0.106.1</Original1061ReferenceDir>

    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original' And Exists('$(OriginalReferenceDir)/sts2.dll')">$(OriginalReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.106.1' And Exists('$(Original1061ReferenceDir)/sts2.dll')">$(Original1061ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And Exists('$(RuntimeReferenceDir)/sts2.dll')">$(RuntimeReferenceDir)</CompatReferenceDir>
  </PropertyGroup>
</Project>
