<Project>
  <PropertyGroup>
    <ReferenceFlavor Condition="'$(ReferenceFlavor)' == ''">runtime</ReferenceFlavor>

    <!--
      Reference DLLs are intentionally supplied by local configuration rather than
      hard-coded workspace paths. Parent build scripts pass CompatReferenceDir from
      .env/local.properties. For standalone builds, set one of these environment
      variables before running dotnet build:

        STS2_RUNTIME_REFERENCE_DIR
        STS2_ORIGINAL_V103_REFERENCE_DIR
        STS2_ORIGINAL_V1061_REFERENCE_DIR
        STS2_ORIGINAL_V1070_REFERENCE_DIR
        STS2_ORIGINAL_V1071_REFERENCE_DIR
        STS2_ORIGINAL_V1080_REFERENCE_DIR
        STS2_ORIGINAL_V1090_REFERENCE_DIR

      The refs/* directories are optional local symlink/copy locations and are not
      required by repository scripts.
    -->
    <RuntimeReferenceDir>$(STS2_RUNTIME_REFERENCE_DIR)</RuntimeReferenceDir>
    <OriginalReferenceDir>$(STS2_ORIGINAL_V103_REFERENCE_DIR)</OriginalReferenceDir>
    <Original1061ReferenceDir>$(STS2_ORIGINAL_V1061_REFERENCE_DIR)</Original1061ReferenceDir>
    <Original1070ReferenceDir>$(STS2_ORIGINAL_V1070_REFERENCE_DIR)</Original1070ReferenceDir>
    <Original1071ReferenceDir>$(STS2_ORIGINAL_V1071_REFERENCE_DIR)</Original1071ReferenceDir>
    <Original1080ReferenceDir>$(STS2_ORIGINAL_V1080_REFERENCE_DIR)</Original1080ReferenceDir>
    <Original1090ReferenceDir>$(STS2_ORIGINAL_V1090_REFERENCE_DIR)</Original1090ReferenceDir>
    <OriginalReferenceDir Condition="'$(OriginalReferenceDir)' == ''">../refs/original</OriginalReferenceDir>
    <Original1061ReferenceDir Condition="'$(Original1061ReferenceDir)' == ''">../refs/original-v0.106.1</Original1061ReferenceDir>
    <Original1070ReferenceDir Condition="'$(Original1070ReferenceDir)' == ''">../refs/original-v0.107.0</Original1070ReferenceDir>
    <Original1071ReferenceDir Condition="'$(Original1071ReferenceDir)' == ''">../refs/original-v0.107.1</Original1071ReferenceDir>
    <Original1080ReferenceDir Condition="'$(Original1080ReferenceDir)' == ''">../refs/original-v0.108.0</Original1080ReferenceDir>
    <Original1090ReferenceDir Condition="'$(Original1090ReferenceDir)' == ''">../refs/original-v0.109.0</Original1090ReferenceDir>

    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original' And Exists('$(OriginalReferenceDir)/sts2.dll')">$(OriginalReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.106.1' And Exists('$(Original1061ReferenceDir)/sts2.dll')">$(Original1061ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.107.0' And Exists('$(Original1070ReferenceDir)/sts2.dll')">$(Original1070ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.107.1' And Exists('$(Original1071ReferenceDir)/sts2.dll')">$(Original1071ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.108.0' And Exists('$(Original1080ReferenceDir)/sts2.dll')">$(Original1080ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And '$(ReferenceFlavor)' == 'original-v0.109.0' And Exists('$(Original1090ReferenceDir)/sts2.dll')">$(Original1090ReferenceDir)</CompatReferenceDir>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == '' And Exists('$(RuntimeReferenceDir)/sts2.dll')">$(RuntimeReferenceDir)</CompatReferenceDir>
  </PropertyGroup>
</Project>
