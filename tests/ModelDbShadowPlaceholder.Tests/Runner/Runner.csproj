<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <CompatReferenceDir Condition="'$(CompatReferenceDir)' == ''">$(MSBuildProjectDirectory)/../../../../.agent/runtime-reference/android</CompatReferenceDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../STS2AndroidPortCompat/STS2Mobile.csproj" ReferenceOutputAssembly="true" />
    <Reference Include="0Harmony"><HintPath>$(CompatReferenceDir)/0Harmony.dll</HintPath></Reference>
    <Reference Include="GodotSharp"><HintPath>$(CompatReferenceDir)/GodotSharp.dll</HintPath></Reference>
    <Reference Include="sts2"><HintPath>$(CompatReferenceDir)/sts2.dll</HintPath></Reference>
  </ItemGroup>
</Project>
